$TTL 604800
@ IN SOA ns1.grzegorzek.lan. admin.grzegorzek.lan. (
    2025060401 ; Serial
    604800     ; Refresh
    86400      ; Retry
    2419200    ; Expire
    604800 )   ; Negative Cache TTL
;
@       IN NS   ns1.grzegorzek.lan.
ns1     IN A    192.168.56.102
jenkins IN A    192.168.56.101
www     IN A    192.168.56.101
@       IN A    192.168.56.101
